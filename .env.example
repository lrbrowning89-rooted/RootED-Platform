# Copy this file to .env in the repository root for local development.
# Never put real secrets in this example file or commit your local .env.

SECRET_KEY=replace-with-a-long-random-local-secret
NGSS_DB=
PII_MODE=full

ENABLE_GOOGLE_AUTH=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

ENABLE_MICROSOFT_AUTH=false
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

ALLOW_SSO_AUTO_CREATE=false

# Used only when intentionally running fix_login.py.
ROOTED_MAINTENANCE_USERNAME=
ROOTED_MAINTENANCE_PASSWORD=
